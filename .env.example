# Server Port & Runtime Environment
PORT=8000
ENVIRONMENT=production
UPAY_JWT_SECRET=your-secure-random-hmac-sha256-signing-secret

# Supabase Cloud Database & Authentication (cedgwabxochvsycsqdpm.supabase.co)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key-here

SUPABASE_JWKS_URL=https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Optional Direct PostgreSQL Connection (if using transaction/session pooler)
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Frontend API Target (for local or Vercel build)
VITE_API_BASE_URL=http://localhost:8000
