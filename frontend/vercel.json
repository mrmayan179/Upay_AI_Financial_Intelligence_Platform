{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/evidence",
      "destination": "/evidence.html"
    },
    {
      "source": "/evidence/",
      "destination": "/evidence.html"
    },
    {
      "source": "/evidence-files/:match*",
      "destination": "/evidence-files/:match*"
    },
    {
      "source": "/((?!evidence).*)",
      "destination": "/index.html"
    }
  ]
}
